---

<Layout title="Saga design studio" description="Saga design studio">
	<section class="hero">
		<div id="hero-slider" class="hero-slider swiper hero__slider">
			<div class="hero-slider__wrapper swiper-wrapper">
				{
					heroImages.map(({ src, desc, title }, idx) =>
						<div class="ratio-wrap ratio-wrap_cover hero-slider__slide swiper-slide">
							<img src={idx === 0 ? src : null} alt={title} class="ratio-wrap__item hero-slider__slide-img"
								data-src={src}
								data-lazyload-trigger-target=".swiper-slide"
								data-lazyload-trigger="class:swiper-slide-active,swiper-slide-next,swiper-slide-prev">
							<div class="hero-slider__slide-info">
								<h3 class="hero-slider__slide-title">{title}</h3>
								<div class="hero-slider__slide-desc">{desc.slice(0, 320) + "..."}</div>
							</div>
						</div>
					)
				}
			</div>
		</div>
		<div class="hero__front">
			<div class="container container_base hero__container">
				<div class="hero__inner">
					{/* <div class="hero__main">
						<h1 class="hero__title">exceptional design<br>build services</h1>
						<span class="hero__subtitle">We take your project from conception to completion!</span>
						<button type="button" class="btn btn_md btn_primary hero__btn">Free Estimate</button>
					</div> */}
					<div class="hero__slider-nav slider-nav">
						<button id="hero-slider-prev-btn" type="button" class="btn btn_nav btn_light hero__btn hero__btn_prev">
							<div class="btn__icon icon-nav-arrow-left"></div>
						</button>
						<button id="hero-slider-next-btn" type="button" class="btn btn_nav btn_light hero__btn hero__btn_next">
							<div class="btn__icon icon-nav-arrow-right"></div>
						</button>
					</div>
					<div class="hero__slider-pagination swiper-pagination swiper-pagination_hero"></div>
				</div>
			</div>
		</div>
	</section>
	<section id="projects" class="projects section section_base section-space">
		<div class="container container_base projects__container section__container">
			<h2 class="section__title" data-component=":intersection-observer:">Projects</h2>
			<div class="container container_titled">
				<div class="container__aside">Recent</div>
				<div class="container__inner">
					<div class="projects__body">
						{
							cases.map(({ src, name, fullName, gallery, date, desc }) =>
								<div class="project-card">
									<a href={src} data-alt={fullName} data-fslightbox={fullName} class:list={["project-card__main projects__card"]}>
										<div class="project-card__img-wrap" data-hover-text="view" data-component=":intersection-observer:">
											<img alt={fullName} class="project-card__img"
												data-src={src}
												data-lazyload
											>
										</div>
										<h3 class="project-card__title" data-component=":intersection-observer:">{name} ({date})</h3>
										<div class="project-card__desc" data-component=":intersection-observer:">{desc.slice(0, 160) + "..."}</div>
									</a>
									<div class="project-card__gallery">
										{
											gallery.map(({ src }) => <a href={src} data-alt={fullName} data-fslightbox={fullName} class:list={["project-card__main projects__card"]}></a>)
										}
									</div>
								</div>
							)
						}
					</div>
				</div>
				<div class="container__aside">Recent</div>
			</div>
		</div>
	</section>
	<section id="services" class="services section section_base section-space">
		<div class="container container_base services__container section__container">
			<h2 class="section__title" data-component=":intersection-observer:">Services</h2>
			<div class="container container_titled">
				<div class="container__aside">Our strenght</div>
				<div class="container__inner">
					<div class="services__body">
						<div class="service-image ratio-wrap ratio-wrap_cover" data-component=":intersection-observer:">
							<img alt="architecture-and-planning" class="service-image__img ratio-wrap__item"
								data-src={"img/architecture-and-planning.png"}
								data-lazyload
							>
						</div>
						<div class="service-info">
							<h3 class="service-info__title tg-card-title" data-component=":intersection-observer:">Architecture and Planning</h3>
							<div class="service-info__desc" data-component=":intersection-observer:">
								<p>Our architecture and planning services go beyond just creating beautiful structures—they focus on thoughtful, intentional design that aligns with your vision and lifestyle.</p>
								<p>Whether you're embarking on a residential project or developing a commercial space, we offer comprehensive planning that ensures your project is not only aesthetically appealing but also functional and sustainable.</p>
								<p>From initial concept to final execution, we collaborate closely with you to refine every detail, incorporating smart design strategies that optimize space, enhance energy efficiency, and anticipate future needs.</p>
								<p>Our expertise in both architectural design and urban planning guarantees that your space will be thoughtfully integrated into its surroundings, serving you and the community for years to come.</p>
							</div>
						</div>
						<div class="logo-card" data-component=":intersection-observer:">
							<div class="icon-logo"></div>
						</div>
						<div class="service-image ratio-wrap ratio-wrap_cover" data-component=":intersection-observer:">
							<img alt="architecture-and-planning" class="service-image__img ratio-wrap__item"
								data-src={"img/interior-design.jpg"}
								data-lazyload
							>
						</div>
						<div class="service-image ratio-wrap ratio-wrap_cover" data-component=":intersection-observer:">
							<img src={"img/interior-design.jpg"} alt="architecture-and-planning" class="service-image__img ratio-wrap__item"
								data-src={"img/interior-design.jpg"}
								data-lazyload
							>
						</div>
						<div class="service-info">
							<h3 class="service-info__title tg-card-title" data-component=":intersection-observer:">Interior Archirecture</h3>
							<div class="service-info__desc" data-component=":intersection-observer:">
								<p>Our interior archirecture services are dedicated to transforming your space into a true reflection of your personality and lifestyle.</p>
								<p>We work closely with you to understand your vision and bring it to life through carefully curated furnishings, color palettes, textures, and layouts that enhance both functionality and beauty.</p>
								<p>Whether you're designing a cozy home or a stylish office, our team ensures that every detail is thoughtfully considered to create a cohesive and inviting atmosphere.</p>
								<p>From concept to completion, we blend aesthetics with practicality, making sure that your space not only looks stunning but feels like the perfect place to live, work, and unwind.</p>
							</div>
						</div>
					</div>
				</div>
				<div class="container__aside">Our strenght</div>
			</div>
		</div>
	</section>
	<section id="testimonials" class="testimonials section section_base section-space">
		<div class="container container_base testimonials__container section__container">
			<h2 class="section__title" data-component=":intersection-observer:">Testimonials</h2>
			<div class="container container_titled">
				<div class="container__aside">Our pride</div>
				<div class="container__inner">
					<div class="testimonials__body">
						<div class="testimonials-card">
							<div class="testimonials-card__img-wrap ratio-wrap ratio-wrap_cover" data-component=":intersection-observer:">
								<img class="testimonials-card__img ratio-wrap__item" alt="Testimonails 01"
									data-src={"img/testimonials-01.jpg"}
									data-lazyload
								></img>
							</div>
							<div class="testimonials-card__body">
							<div class="testimonials-card__main">
								<img src="img/quote.svg" alt="Quote" class="testimonials-card__decor" data-component=":intersection-observer:">
								<div class="testimonials-card__title" data-component=":intersection-observer:">Amazing team!</div>
								<div class="testimonials-card__text" data-component=":intersection-observer:">Working with Gala and Sasha has been an absolute pleasure. From the very beginning, they truly listened to our vision and transformed it into a design that exceeded our expectations. Their attention to detail, creativity, and dedication to every aspect of the project made the entire process smooth and enjoyable. We now have a space that perfectly reflects who we are, and it's everything we dreamed of—functional, beautiful, and so thoughtfully designed. We couldn’t be happier with the results!</div>
							</div>
							{/* <div class="testimonials-card__footer" data-component=":intersection-observer:">
								<div class="testimonials-card__project">Project name</div>
								<div class="testimonials-card__author">Author’s name</div>
								<div class="testimonials-card__author-title">Author’s title</div>
							</div> */}
						</div>
						</div>
						<div class="testimonials-card">
							<div class="testimonials-card__img-wrap ratio-wrap ratio-wrap_cover" data-component=":intersection-observer:">
								<img class="testimonials-card__img ratio-wrap__item" alt="Testimonails 01"
									data-src={"img/testimonials-02.jpg"}
									data-lazyload
								></img>
							</div>
							<div class="testimonials-card__body">
								<div class="testimonials-card__main">
									<img src="img/quote.svg" alt="Quote" class="testimonials-card__decor" data-component=":intersection-observer:">
									<div class="testimonials-card__title" data-component=":intersection-observer:">Beautiful design!</div>
									<div class="testimonials-card__text" data-component=":intersection-observer:">I can’t thank Gala and Sasha enough for their incredible work on our project. They approached every challenge with innovative solutions and a deep understanding of our needs. What stood out most was their ability to balance creativity with practicality, ensuring that the design was not only visually striking but also perfectly suited to our day-to-day life. Throughout the entire process, they were professional, communicative, and always went above and beyond to deliver on time.</div>
								</div>
								{/* <div class="testimonials-card__footer" data-component=":intersection-observer:">
									<div class="testimonials-card__project">Project name</div>
									<div class="testimonials-card__author">Author’s name</div>
									<div class="testimonials-card__author-title">Author’s title</div>
								</div> */}
							</div>
						</div>
					</div>
				</div>
				<div class="container__aside">Our pride</div>
			</div>
		</div>
	</section>
	<div class="drawers" slot="drawers">
	
	</div>
</Layout>